---
// Landing page institucional Selfcomp
---
<!DOCTYPE html>
<html class="dark scroll-smooth" lang="pt-BR">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Selfcomp Tecnologia — Automação e IA para Empresas B2B</title>
  <meta name="description" content="Reduza tarefas manuais, responda clientes mais rápido e organize sua operação. A Selfcomp integra WhatsApp, CRM, sistemas e Inteligência Artificial para sua empresa trabalhar melhor."/>

  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet"/>

  <style is:global>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
      main > :first-child { margin-top: 0 !important; }
      main > :last-child { margin-bottom: 0 !important; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>

  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-tertiary": "#003915",
            "surface-bright": "#353943",
            "on-tertiary-fixed-variant": "#005321",
            "primary-fixed-dim": "#ffb693",
            "inverse-surface": "#dfe2ef",
            "tertiary-fixed": "#6bff8f",
            "on-surface": "#dfe2ef",
            "on-primary-fixed-variant": "#7a3000",
            "outline": "#a98a7d",
            "inverse-primary": "#a04100",
            "primary": "#ffb693",
            "tertiary-container": "#00b050",
            "surface": "#0f131c",
            "primary-fixed": "#ffdbcc",
            "surface-container-highest": "#31353f",
            "error": "#ffb4ab",
            "inverse-on-surface": "#2c303a",
            "error-container": "#93000a",
            "surface-tint": "#ffb693",
            "on-tertiary-container": "#003a15",
            "surface-variant": "#31353f",
            "on-tertiary-fixed": "#002109",
            "on-secondary-fixed-variant": "#783200",
            "outline-variant": "#5a4136",
            "surface-container-lowest": "#0a0e17",
            "on-error": "#690005",
            "secondary-container": "#ec6a06",
            "on-secondary-fixed": "#341100",
            "surface-dim": "#0f131c",
            "on-secondary-container": "#4a1c00",
            "tertiary-fixed-dim": "#4ae176",
            "tertiary": "#4ae176",
            "on-primary-container": "#572000",
            "secondary-fixed-dim": "#ffb690",
            "secondary": "#ffb690",
            "on-primary": "#561f00",
            "surface-container-low": "#181b25",
            "surface-container-high": "#262a34",
            "on-primary-fixed": "#351000",
            "on-surface-variant": "#e2bfb0",
            "on-error-container": "#ffdad6",
            "secondary-fixed": "#ffdbca",
            "on-background": "#dfe2ef",
            "primary-container": "#ff6b00",
            "background": "#0f131c",
            "surface-container": "#1c1f29",
            "on-secondary": "#552100"
          },
          borderRadius: {
            "DEFAULT": "0.125rem",
            "lg": "0.25rem",
            "xl": "0.5rem",
            "full": "0.75rem"
          },
          spacing: {
            "space-sm": "0.5rem",
            "gutter": "1.5rem",
            "space-xs": "0.25rem",
            "gutter-sm": "1rem",
            "margin": "2rem",
            "space-xl": "2.5rem",
            "gutter-lg": "2rem",
            "margin-mobile": "1rem",
            "space-lg": "1.5rem",
            "space-md": "1rem"
          },
          fontFamily: {
            "headline-lg-mobile": [ "Plus Jakarta Sans" ],
            "display-xl-mobile": [ "Plus Jakarta Sans" ],
            "body-md": [ "Plus Jakarta Sans" ],
            "body-sm": [ "Plus Jakarta Sans" ],
            "label-code": [ "JetBrains Mono" ],
            "headline-md": [ "Plus Jakarta Sans" ],
            "body-lg": [ "Plus Jakarta Sans" ],
            "headline-sm": [ "Plus Jakarta Sans" ],
            "headline-lg": [ "Plus Jakarta Sans" ],
            "label-badge": [ "JetBrains Mono" ],
            "display-xl": [ "Plus Jakarta Sans" ]
          },
          fontSize: {
            "headline-lg-mobile": [ "26px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" } ],
            "display-xl-mobile": [ "36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" } ],
            "body-md": [ "14px", { "lineHeight": "22px", "letterSpacing": "0em", "fontWeight": "400" } ],
            "body-sm": [ "12px", { "lineHeight": "18px", "letterSpacing": "0.01em", "fontWeight": "400" } ],
            "label-code": [ "13px", { "lineHeight": "18px", "letterSpacing": "-0.01em", "fontWeight": "500" } ],
            "headline-md": [ "24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" } ],
            "body-lg": [ "16px", { "lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "400" } ],
            "headline-sm": [ "18px", { "lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "600" } ],
            "headline-lg": [ "32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "600" } ],
            "label-badge": [ "11px", { "lineHeight": "14px", "letterSpacing": "0.06em", "fontWeight": "600" } ],
            "display-xl": [ "56px", { "lineHeight": "64px", "letterSpacing": "-0.03em", "fontWeight": "700" } ]
          }
        }
      }
    };
  </script>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary">

  <!-- HEADER -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-surface-container-lowest/95 backdrop-blur-xl border-b border-surface-container-highest">
    <div class="h-20 max-w-[1320px] mx-auto px-margin flex items-center justify-between gap-space-lg">
      <div class="flex items-center gap-space-md">
        <a class="flex items-center gap-space-sm group" href="#">
          <img alt="Selfcomp" class="h-8 w-auto" src="/assets/Selfcomp-logo.png" onerror="this.src='https://lh3.googleusercontent.com/aida/AEtjO1WRCnRRHyY4xD1nQZ7pc2S2bl57tH_pa_yuMQxPj1Ky-nYCmRIx7nKhXTGubDzzPVrmXNHYimdsudM93Dye9M2o7_bKkJ8XW5EKxv-yhvU_bZu3xOAO32eACfVnaQpOIS-CE6CGwhTKMoZkx5WqDTjZzq4res7ij1JaJlbVxnKa6KXAFs5Hk_MHShep0V1R8Lx8r34bAFmSu8sCNOadFgoiHdxa4mK3sYLKB3B4Gqp0mvfIdOK7y_jP69M'"/>
        </a>
      </div>
      <nav class="hidden xl:flex items-center gap-space-lg">
        <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#">Início</a>
        <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#automatizar">Automatizar</a>
        <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#solucoes">Soluções</a>
        <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#deskai">DeskAI</a>
        <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#empresa">Empresa</a>
        <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#diagnostico">Contato</a>
      </nav>
      <div class="flex items-center gap-space-md">
        <a class="inline-flex items-center gap-space-xs px-space-md py-space-sm bg-primary-container text-on-primary font-headline-sm text-body-md font-semibold rounded-lg shadow-[0_0_20px_-4px_rgba(255,107,0,0.4)] hover:brightness-110 active:scale-95 transition-all" href="/agendar" data-track="click_schedule_diagnosis">
          <span>Agendar diagnóstico</span>
          <span class="material-symbols-outlined text-[18px]">calendar_today</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]">
    <div class="flex flex-col w-full">

      <!-- SECTION 01: HERO -->
      <section class="relative w-full overflow-hidden bg-surface py-space-xl md:py-32">
        <div class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[800px] -translate-x-1/2 rounded-full bg-gradient-to-b from-primary-container/15 via-secondary-container/5 to-transparent blur-3xl"></div>
        <div class="relative mx-auto max-w-[1320px] px-margin flex flex-col items-center text-center">
          <div class="inline-flex items-center gap-space-xs rounded-full bg-surface-container-high px-space-md py-space-xs text-on-surface ring-1 ring-primary-container/30 shadow-[0_0_24px_-4px_rgba(255,107,0,0.25)]">
            <span class="h-2 w-2 rounded-full bg-primary-container animate-ping"></span>
            <span class="font-label-badge text-label-badge uppercase tracking-wider text-primary">Automação e Inteligência Artificial para Empresas</span>
          </div>
          <h1 class="mt-space-lg max-w-4xl font-display-xl text-display-xl text-on-surface">
            Automatize atendimento, vendas e processos com <span class="bg-gradient-to-r from-primary to-primary-container bg-clip-text text-transparent">IA</span>.
          </h1>
          <p class="mt-space-lg max-w-3xl font-body-lg text-body-lg text-on-surface-variant">
            Reduza tarefas manuais, responda clientes mais rápido e organize sua operação. A Selfcomp integra WhatsApp, CRM, sistemas e Inteligência Artificial para sua empresa trabalhar melhor.
          </p>
          <div class="mt-space-xl flex flex-wrap items-center justify-center gap-space-md">
            <a class="inline-flex items-center gap-space-xs rounded-lg bg-primary-container px-space-xl py-space-md font-headline-sm text-body-lg font-semibold text-on-primary shadow-[0_0_30px_rgba(255,107,0,0.4)] hover:brightness-110 active:scale-95 transition-all" href="/agendar" data-track="click_schedule_diagnosis">
              <span>Agendar diagnóstico</span>
              <span class="material-symbols-outlined text-[20px]">calendar_month</span>
            </a>
            <a class="inline-flex items-center gap-space-xs rounded-lg bg-[#25D366]/20 border border-[#25D366]/40 text-[#25D366] px-space-xl py-space-md font-headline-sm text-body-lg font-semibold hover:bg-[#25D366]/30 transition-all shadow-sm" href="https://wa.me/5551993696153" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click">
              <span class="material-symbols-outlined text-[20px]">chat</span>
              <span>Falar no WhatsApp</span>
            </a>
          </div>
          <div class="mt-space-sm flex items-center justify-center gap-space-xs font-label-badge text-label-badge uppercase tracking-wider text-outline">
            <span class="material-symbols-outlined text-[16px] text-tertiary">verified</span>
            <span>30 minutos • Online • Presencial</span>
          </div>
        </div>
      </section>

      <!-- SECTION 02: PROBLEMA -->
      <section class="w-full bg-surface-container-lowest py-space-xl" id="problema">
        <div class="mx-auto max-w-[1320px] px-margin">
          <div class="text-center max-w-3xl mx-auto mb-space-xl">
            <span class="font-label-badge text-label-badge uppercase tracking-wider text-primary">O problema</span>
            <h2 class="mt-space-xs font-headline-lg text-headline-lg text-on-surface">
              Sua empresa perde tempo com tarefas que poderiam ser automatizadas?
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md max-w-5xl mx-auto">
            <div class="rounded-xl bg-surface-container-low p-space-lg shadow-sm">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-primary">
                <span class="material-symbols-outlined text-[26px]">person_search</span>
              </div>
              <span class="mt-space-md block font-headline-sm text-headline-sm text-on-surface">Leads esquecidos</span>
              <p class="mt-space-xs font-body-md text-body-md text-on-surface-variant">Clientes entram em contato e ninguém acompanha.</p>
            </div>
            <div class="rounded-xl bg-surface-container-low p-space-lg shadow-sm">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-secondary">
                <span class="material-symbols-outlined text-[26px]">content_copy</span>
              </div>
              <span class="mt-space-md block font-headline-sm text-headline-sm text-on-surface">Trabalho repetitivo</span>
              <p class="mt-space-xs font-body-md text-body-md text-on-surface-variant">Sua equipe perde tempo copiando informações e atualizando sistemas.</p>
            </div>
            <div class="rounded-xl bg-surface-container-low p-space-lg shadow-sm">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-tertiary">
                <span class="material-symbols-outlined text-[26px]">folder_open</span>
              </div>
              <span class="mt-space-md block font-headline-sm text-headline-sm text-on-surface">Informações espalhadas</span>
              <p class="mt-space-xs font-body-md text-body-md text-on-surface-variant">WhatsApp, planilhas, e-mails e sistemas não conversam.</p>
            </div>
          </div>
          <div class="mt-space-xl max-w-3xl mx-auto rounded-xl bg-surface-container p-space-lg text-center shadow-md">
            <span class="font-headline-md text-headline-md font-semibold text-primary">A Selfcomp conecta essas operações e automatiza o que é repetitivo.</span>
          </div>
        </div>
      </section>

      <!-- SECTION 03: O QUE PODEMOS AUTOMATIZAR -->
      <section class="w-full bg-surface py-space-xl" id="automatizar">
        <div class="mx-auto max-w-[1320px] px-margin">
          <div class="text-center max-w-2xl mx-auto mb-space-xl">
            <span class="font-label-badge text-label-badge uppercase tracking-wider text-primary">Possibilidades</span>
            <h2 class="mt-space-xs font-headline-lg text-headline-lg text-on-surface">O que podemos automatizar na sua empresa?</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
            <div class="group rounded-xl bg-surface-container-low p-space-lg shadow-sm hover:bg-surface-container transition-all">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-primary-container group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[26px]">support_agent</span>
              </div>
              <span class="mt-space-md block font-headline-sm text-headline-sm text-on-surface">Atendimento</span>
              <p class="mt-space-xs font-body-sm text-body-sm text-on-surface-variant">Responder dúvidas, coletar informações, qualificar clientes e direcionar atendimentos.</p>
            </div>
            <div class="group rounded-xl bg-surface-container-low p-space-lg shadow-sm hover:bg-surface-container transition-all">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-tertiary group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[26px]">trending_up</span>
              </div>
              <span class="mt-space-md block font-headline-sm text-headline-sm text-on-surface">Vendas</span>
              <p class="mt-space-xs font-body-sm text-body-sm text-on-surface-variant">Cadastrar leads, organizar oportunidades, atualizar CRM e automatizar follow-ups.</p>
            </div>
            <div class="group rounded-xl bg-surface-container-low p-space-lg shadow-sm hover:bg-surface-container transition-all">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-secondary group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[26px]">description</span>
              </div>
              <span class="mt-space-md block font-headline-sm text-headline-sm text-on-surface">Administrativo</span>
              <p class="mt-space-xs font-body-sm text-body-sm text-on-surface-variant">Organizar informações, documentos, solicitações e tarefas repetitivas.</p>
            </div>
            <div class="group rounded-xl bg-surface-container-low p-space-lg shadow-sm hover:bg-surface-container transition-all">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-primary-fixed-dim group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[26px]">hub</span>
              </div>
              <span class="mt-space-md block font-headline-sm text-headline-sm text-on-surface">Integrações</span>
              <p class="mt-space-xs font-body-sm text-body-sm text-on-surface-variant">Fazer WhatsApp, CRM, ERP, e-mail e outros sistemas trabalharem juntos.</p>
            </div>
          </div>
          <div class="mt-space-xl max-w-2xl mx-auto rounded-xl bg-surface-container border border-surface-container-highest p-space-lg text-center shadow-sm">
            <p class="font-body-lg text-body-lg text-on-surface">
              <strong class="text-primary">Não sabe o que pode ser automatizado?</strong> É justamente isso que identificamos no diagnóstico.
            </p>
            <div class="mt-space-md">
              <a class="inline-flex items-center gap-space-xs rounded-lg bg-primary-container px-space-xl py-space-md font-headline-sm text-body-lg font-semibold text-on-primary shadow-[0_0_24px_rgba(255,107,0,0.3)] hover:brightness-110 active:scale-95 transition-all" href="/agendar" data-track="click_schedule_diagnosis">
                <span>Agendar diagnóstico</span>
                <span class="material-symbols-outlined text-[20px]">calendar_month</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 04: SOLUÇÕES -->
      <section class="w-full bg-surface-container-lowest py-space-xl" id="solucoes">
        <div class="mx-auto max-w-[1320px] px-margin">
          <div class="text-center max-w-2xl mx-auto mb-space-xl">
            <span class="font-label-badge text-label-badge uppercase tracking-wider text-primary">Soluções Integradas</span>
            <h2 class="mt-space-xs font-headline-lg text-headline-lg text-on-surface">Tecnologia trabalhando junto com sua equipe.</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
            <div class="group rounded-xl bg-surface-container-low p-space-lg flex flex-col justify-between shadow-sm hover:shadow-xl transition-all">
              <div>
                <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-primary">
                  <span class="material-symbols-outlined text-[26px]">smart_toy</span>
                </div>
                <h3 class="mt-space-md font-headline-md text-headline-md text-on-surface">Atendimento &amp; Vendas</h3>
                <p class="mt-space-xs font-body-md text-body-md text-on-surface-variant">
                  WhatsApp, CRM, atendimento, qualificação e acompanhamento comercial.
                </p>
              </div>
              <div class="mt-space-lg flex flex-wrap gap-space-xs">
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">WhatsApp</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">CRM</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">Qualificação</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">Acompanhamento</span>
              </div>
            </div>
            <div class="group rounded-xl bg-surface-container-low p-space-lg flex flex-col justify-between shadow-sm hover:shadow-xl transition-all">
              <div>
                <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-tertiary">
                  <span class="material-symbols-outlined text-[26px]">sync_alt</span>
                </div>
                <h3 class="mt-space-md font-headline-md text-headline-md text-on-surface">Automação de Processos</h3>
                <p class="mt-space-xs font-body-md text-body-md text-on-surface-variant">
                  Eliminamos tarefas repetitivas conectando as ferramentas que sua empresa já utiliza.
                </p>
              </div>
              <div class="mt-space-lg flex flex-wrap gap-space-xs">
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">WhatsApp</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">E-mail</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">CRM</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">ERP</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">APIs</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">Planilhas</span>
              </div>
            </div>
            <div class="group rounded-xl bg-surface-container-low p-space-lg flex flex-col justify-between shadow-sm hover:shadow-xl transition-all">
              <div>
                <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container-high text-secondary">
                  <span class="material-symbols-outlined text-[26px]">psychology</span>
                </div>
                <h3 class="mt-space-md font-headline-md text-headline-md text-on-surface">Agentes de IA</h3>
                <p class="mt-space-xs font-body-md text-body-md text-on-surface-variant">
                  Criamos agentes para executar tarefas específicas da sua operação.
                </p>
              </div>
              <div class="mt-space-lg flex flex-wrap gap-space-xs">
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">Vendas</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">Atendimento</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">Suporte</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">Documentos</span>
                <span class="rounded-full bg-surface-container px-space-sm py-1 font-label-badge text-label-badge text-on-surface">Operações</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 05: CENÁRIO DAS 22H -->
      <section class="w-full bg-surface py-space-xl">
        <div class="mx-auto max-w-[1320px] px-margin">
